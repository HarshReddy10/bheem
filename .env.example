# ============================================================
# Bheem WhatsApp AI Chatbot — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# --- Application ---
APP_NAME=Bheem WhatsApp Chatbot
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/bheem.db

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_VERIFY_TOKEN=bheem_verify_token_2024
WHATSAPP_APP_SECRET=your_app_secret

# --- LLM Provider ---
# Options: mock, antigravity
LLM_PROVIDER=mock
ANTIGRAVITY_API_KEY=your_api_key
ANTIGRAVITY_API_URL=https://api.antigravity.example.com/v1
ANTIGRAVITY_MODEL=antigravity-default

# --- RAG Settings ---
KNOWLEDGE_BASE_DIR=./knowledge_base
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# --- Conversation ---
MAX_CONVERSATION_HISTORY=20
CONVERSATION_TIMEOUT_HOURS=24

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data/logs/bheem.log
