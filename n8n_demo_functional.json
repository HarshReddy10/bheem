{
  "name": "Demo WhatsApp AI Closing Agent",
  "nodes": [
    {
      "parameters": {
        "content": "## Workflow 1: Customer Conversation\nState machine loop with AI fallback.",
        "height": 1300,
        "width": 600,
        "color": 1
      },
      "id": "s1",
      "name": "Sticky Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-50, -100]
    },
    {
      "parameters": {
        "path": "customer-message",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "f1-1",
      "name": "Customer Message Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "// Extract incoming message from WhatsApp payload\nlet messageText = '';\nlet fromNumber = '';\n\nif ( $input.first().json.body.entry ) {\n  const entry = $input.first().json.body.entry[0];\n  if (entry.changes && entry.changes[0].value.messages) {\n    const msg = entry.changes[0].value.messages[0];\n    fromNumber = msg.from;\n    if (msg.type === 'text') {\n      messageText = msg.text.body;\n    } else if (msg.type === 'interactive') {\n      if (msg.interactive.type === 'button_reply') {\n        messageText = msg.interactive.button_reply.id;\n      } else if (msg.interactive.type === 'list_reply') {\n        messageText = msg.interactive.list_reply.id;\n      }\n    }\n  }\n}\n\nreturn {\n  message: messageText,\n  from: fromNumber\n};"
      },
      "id": "f1-2",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [0, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.message }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "f1-4",
      "name": "Is Valid Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [0, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=REPLACE_WITH_N8N_CREDENTIAL",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contents",
              "value": "={{ [ { \"parts\": [ { \"text\": \"You are a helpful sales assistant. The user said: '\" + $json.message + \"'. Reply concisely and helpfully.\" } ] } ] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f1-7",
      "name": "💬 Generate Intelligent Recommendation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 600]
    },
    {
      "parameters": {
        "jsCode": "// Extract AI response\nconst aiResponse = $input.first().json.candidates[0].content.parts[0].text;\nreturn {\n  reply: aiResponse,\n  from: $('Extract Message').first().json.from\n};"
      },
      "id": "f1-9",
      "name": "Format Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [200, 800]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/1167151956490306/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_N8N_CREDENTIAL"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{ $json.from }}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text",
              "value": "={{ { \"body\": $json.reply } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "f1-10",
      "name": "Send WhatsApp Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 1000]
    },
    {
      "parameters": {
